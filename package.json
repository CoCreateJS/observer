{
  "name": "@cocreate/observer",
  "version": "1.25.0",
  "description": "Register a components init function & observe selector. The init function will be fired immedietly after detection of selector.",
  "keywords": [
    "observer",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Register a components init function & observe selector. The init function will be fired immedietly after detection of selector.",
      "source": "src/index.js",
      "api": {
        "exports": [
          "init",
          "parseSelector",
          "processMutations",
          "everyElement",
          "executeCallbacks",
          "uninit",
          "removeObserver"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-observer.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-observer/issues"
  },
  "homepage": "https://cocreate.app/docs/observer",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/utils": "^1.54.0",
    "css-selector-parser": "^1.4.1"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
